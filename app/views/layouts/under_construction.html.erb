<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= @page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <link
      rel="icon"
      type="image/png"
      href="https://res.cloudinary.com/dnojcwwos/image/upload/v1776416329/08a6a08d-1b8c-4227-8c88-718ef85ffe28.png"
    >
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: system-ui, sans-serif;
        background: #fff;
        color: #111;
        text-align: center;
      }
      main { padding: 2rem; max-width: 36rem; }
      h1 { font-size: 2rem; margin: 0 0 1rem; }
      p { line-height: 1.5; margin: 0 0 1.5rem; }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
