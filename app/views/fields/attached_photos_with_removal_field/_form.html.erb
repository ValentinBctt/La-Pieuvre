<div class="field-unit__label">
  <%= f.label field.attribute, for: "#{f.object_name}_#{field.attribute}" %>
</div>

<div class="field-unit__field" data-attached-photos-with-removal>
  <% field.attachments.each do |attachment| %>
    <div class="attached-photo-item" style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
      <%= image_tag url_for(attachment), style: "width: 72px; height: 72px; object-fit: cover; border-radius: 6px;" %>
      <label style="display:flex; align-items:center; gap:0.4rem;">
        <input type="checkbox" name="<%= f.object_name %>[remove_photo_ids][]" value="<%= attachment.id %>" />
        Supprimer
      </label>
    </div>
  <% end %>

  <%= f.file_field field.attribute, multiple: true, direct_upload: true, include_hidden: false %>
</div>