<% if field.attachments.any? %>
  <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
    <% field.attachments.each do |attachment| %>
      <%= image_tag url_for(attachment), style: "width: 96px; height: 96px; object-fit: cover; border-radius: 6px;" %>
    <% end %>
  </div>
<% else %>
  <em>Aucune photo</em>
<% end %>