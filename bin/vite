#!/usr/bin/env ruby
# frozen_string_literal: true

project_bin = File.expand_path(__dir__)
ENV["PATH"] = "#{project_bin}#{File::PATH_SEPARATOR}#{ENV.fetch("PATH", "")}" unless ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).first == project_bin

#
# This file was generated by Bundler.
#
# The application 'vite' is installed as part of a gem, and
# this file is here to facilitate running it.
#

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "rubygems"
require "bundler/setup"

load Gem.bin_path("vite_ruby", "vite")
