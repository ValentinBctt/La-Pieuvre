#!/usr/bin/env sh

PROJECT_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$PROJECT_ROOT" || exit 1
export PATH="$PROJECT_ROOT/bin:$PATH"

export RBENV_VERSION="$(tr -d '[:space:]' < .ruby-version)"

if [ -f tmp/pids/server.pid ]; then
	OLD_RAILS_PID="$(tr -d '[:space:]' < tmp/pids/server.pid)"
	if [ -n "$OLD_RAILS_PID" ] && kill -0 "$OLD_RAILS_PID" 2>/dev/null; then
		kill -9 "$OLD_RAILS_PID" 2>/dev/null || true
	fi
	rm -f tmp/pids/server.pid
fi

pkill -9 -f "${PROJECT_ROOT}/node_modules/vite/bin/vite.js" 2>/dev/null || true
pkill -9 -f "${PROJECT_ROOT}/.*vite dev" 2>/dev/null || true
pkill -9 -f "${PROJECT_ROOT}/.*bin/rails s" 2>/dev/null || true

# Start Vite dev server
rbenv exec bundle exec vite dev &
VITE_PID=$!

# Start Rails server
rbenv exec bundle exec rails s -b 0.0.0.0 &
RAILS_PID=$!

# Handle cleanup on exit
trap "kill $VITE_PID $RAILS_PID 2>/dev/null" EXIT INT TERM

# Wait for both processes
wait
